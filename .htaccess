# Joyería Estambul — Cache y compresión para Hostinger
# Quien vuelva a la página encuentra todo cacheado en su teléfono.

# Compresión GZIP (reduce el tamaño de HTML, CSS, JS)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache agresivo para assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On

  # Imágenes: 6 meses (las fotos no cambian)
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"

  # Fuentes: 1 año
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # CSS y JS: 1 mes (usamos ?v= para romper cache cuando cambiemos)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # HTML: 1 hora (para que los cambios se vean rápido)
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
  # Imágenes y fuentes: cache inmutable
  <FilesMatch "\.(jpg|jpeg|png|webp|woff2|woff|svg)$">
    Header set Cache-Control "public, max-age=15768000, immutable"
  </FilesMatch>

  # JS y CSS: cache con revalidación
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Seguridad básica
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
